// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`guide renderer > renders a guide without links exactly as before 1`] = `"<article class="mt-6"><p class="text-small font-semibold text-green">Buying, selling and renting</p><h1 class="hl-h1 mt-1">Property viewing checklist</h1><p class="mt-3 text-[1.0625rem] text-muted">What to look at, and what to ask, when you view a house or apartment.</p><p class="mt-3 text-small text-muted">Updated 15 Oct 2026</p><div class="mt-8 space-y-4 text-[1.0625rem] leading-relaxed"><p>A viewing is your chance to check the property and ask questions before you make an offer or sign a lease.</p><h2 class="hl-h3 pt-4">Outside</h2><ul class="list-disc space-y-1 pl-6"><li>Cracks in walls, signs of damp and the condition of the roof</li><li>Access roads, parking and the neighbourhood at different times of day</li></ul><h2 class="hl-h3 pt-4">Inside</h2><ul class="list-disc space-y-1 pl-6"><li>Water pressure, electricity and signs of leaks</li><li>Doors, windows and locks</li><li>Natural light and ventilation</li></ul><h2 class="hl-h3 pt-4">Questions to ask</h2><ul class="list-disc space-y-1 pl-6"><li>Who owns the property, and can I see the documents?</li><li>What is included in the price or rent?</li><li>Are there any service charges or shared costs?</li></ul><p>Never pay a deposit before you have seen the property and checked who you are dealing with.</p></div><section aria-labelledby="faq-heading" class="mt-12"><h2 id="faq-heading" class="hl-h2 mb-4">Questions</h2><div class="divide-y divide-border rounded-lg border border-border bg-white"><details id="faq-0" class="group"><summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-semibold text-ink [&amp;::-webkit-details-marker]:hidden"><span>Can someone view a property for me if I live abroad?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-5 shrink-0 text-muted transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="px-5 pb-5 text-muted">Yes. You can ask a trusted person, or use HagerLand&#x27;s services for buyers abroad where available.</div></details></div></section><p class="mt-12 rounded-md bg-stone-50 p-4 text-small text-muted">This guide is general information, not legal, financial or professional advice. Check anything important with a qualified professional.</p></article>"`;
