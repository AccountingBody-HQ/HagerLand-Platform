# Copy to .env.local for local development. Never commit real values.

# Site (optional: overrides the automatic URL; production uses https://www.hagerland.com)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# Admin console (/roodber8)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=at-least-32-random-characters
ADMIN_TOTP_SECRET=
ADMIN_DIGEST_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend). Senders must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=HagerLand <hello@hagerland.com>
EMAIL_FROM_SUPPLY=HagerLand Supply <supply@hagerland.com>
EMAIL_REPLY_TO=
HAGERLAND_INBOX_EMAIL=

# Security
CRON_SECRET=at-least-16-random-characters
IP_HASH_SALT=at-least-16-random-characters

# Google (Places API (New) for admin imports; Maps Embed key restricted to hagerland.com)
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# AI description drafting for imports
ANTHROPIC_API_KEY=
# Optional: model used for drafts (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Google sign-in button: set to true only after Google is enabled in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Daily job: also delete expired rows from the pre-existing rate_limits table (true/false)
CRON_PURGE_RATE_LIMITS=

# Automated tests only (local copy): deliver every email to the local Mailpit catcher instead of Resend.
# Must be a localhost address; never set it on Vercel.
EMAIL_TEST_MAILPIT_URL=

# Map tiles (optional). Maps appear only when this is set: a tile URL with {z}/{x}/{y} and your provider's key,
# e.g. https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY (commercial use must be allowed).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Cutover only, in .env.local on this Codespace (NEVER on Vercel): the live database connection string with password
# (Supabase → Connect → Session pooler). Used by scripts/cutover/* after AB types GO LIVE; delete it after the cutover.
SUPABASE_DB_URL=

# Set automatically by Vercel and Next.js, never by hand:
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA, NEXT_PUBLIC_VERCEL_ENV, NEXT_PUBLIC_VERCEL_URL,
# NODE_ENV, NEXT_RUNTIME, NEXT_PHASE. NEXT_DIST_DIR is used only by the automated test build (.next-test).
